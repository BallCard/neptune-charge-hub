    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "qrcode": "1.5.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
